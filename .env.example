# 環境變數範本檔案
# Flyway 可透過環境變數覆蓋 flyway.conf 中的設定值
# 複製此檔案為 .env 並根據環境調整設定值

# ================================================================================
# 資料庫連線設定 (覆蓋 flyway.conf 中的 flyway.url)
# ================================================================================
# 本地開發環境
FLYWAY_URL=jdbc:postgresql://localhost:5432/maplay
FLYWAY_USER=postgres
FLYWAY_PASSWORD=postgres

# Docker 環境 (取消註釋以使用)
# FLYWAY_URL=jdbc:postgresql://postgres:5432/maplay
# FLYWAY_USER=postgres
# FLYWAY_PASSWORD=postgres_password

# 生產環境 (取消註釋並填入實際值)
# FLYWAY_URL=jdbc:postgresql://production-db.example.com:5432/maplay
# FLYWAY_USER=maplay_user
# FLYWAY_PASSWORD=secure_password_here

# ================================================================================
# 其他 Flyway 設定 (可選覆蓋)
# ================================================================================
# FLYWAY_LOCATIONS=filesystem:db/migration
# FLYWAY_VALIDATE_ON_MIGRATE=true
# FLYWAY_BASELINE_ON_MIGRATE=true

# ================================================================================
# 使用說明
# ================================================================================
# 1. 複製此檔案: cp .env.example .env
# 2. 根據當前環境調整設定值
# 3. 將 .env 加入 .gitignore (避免敏感資訊提交)
# 4. Flyway 會自動讀取環境變數優先於 flyway.conf 設定